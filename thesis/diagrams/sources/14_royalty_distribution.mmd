flowchart TD
    A[Sale confirms<br/>price = p] --> B{"parentAssetId != 0?"}
    B -->|No| C[seller gets p<br/>no royalty]
    B -->|Yes| D[parentAmount = p * royaltyBps / 10000<br/>sellerAmount = p - parentAmount]
    D --> E[Pay seller: sellerAmount]
    D --> F["Credit parent: parentAmount"]
    E --> G[Return buyer bond to buyer]
    F --> G
    G --> H[Return seller bond to sellerCredit]
    H --> I[Mint licence token to buyer]

    J[Parent seller] --> K["withdraw() - transfer credit"]
    K --> L[Pull payment pattern]

