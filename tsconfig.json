{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "."
  },
  "include": [
    "crypto/**/*.ts",
    "api/**/*.ts",
    "watcher/**/*.ts",
    "cli.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}